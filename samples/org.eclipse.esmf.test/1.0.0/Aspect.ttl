@prefix : <urn:samm:org.eclipse.esmf.test:1.0.0#> .
@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .

:odometer a samm:Aspect ;
   samm:preferredName "Odometer"@en ;
   samm:properties ( :vehicleMilage ) ;
   samm:operations ( ) .

:vehicleMilage a samm:Property ;
    samm:description "Specifies the mileage of the vehicle associated with the quality complaint."@en ;
    samm:preferredName "Vehicle Milage"@en ;
    samm:characteristic :Milage .

:Milage a samm-c:Measurement ;
    samm:dataType xsd:positiveInteger ;
    samm:description "Specifies the mileage of the vehicle in kilometers."@en .
