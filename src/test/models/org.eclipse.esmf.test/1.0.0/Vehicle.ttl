@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix : <urn:samm:org.eclipse.esmf.test:1.0.0#> .

:Vehicle a samm:Aspect ;
   samm:preferredName "vehicle"@en ;
   samm:preferredName "Fahrzeug"@de ;
   samm:description "A vehicle with a deliberately long English description so that the graphical view has to wrap this attribute row across several lines."@en ;
   samm:description "Ein Fahrzeug."@de ;
   samm:properties ( :position ) ;
   samm:operations ( ) ;
   samm:events ( ) .

:position a samm:Property ;
   samm:preferredName "position"@en ;
   samm:characteristic :Position .
